{
  "name": "@redpine-ai/sdk",
  "version": "0.1.8",
  "description": "TypeScript client for the Redpine search API",
  "license": "MIT",
  "homepage": "https://docs.redpine.ai/docs/sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redpine-ai/redpine-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/redpine-ai/redpine-sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^20",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.3.1",
      "vite": "^6.4.3"
    }
  }
}
